# Skywatch — personal & deployment settings.  cp .env.example .env
# Everything here overrides config.yaml (which holds the tunables and is generic).
# All values are optional except SKYWATCH_LOCATION.

# Where you are. A UK postcode, a place name, or "lat,lon".
#   SKYWATCH_LOCATION=LA22 9BU
#   SKYWATCH_LOCATION=Ambleside
#   SKYWATCH_LOCATION=54.4287,-2.9613
SKYWATCH_LOCATION=Ambleside
# Friendly name for briefings (defaults to what the geocoder returns).
SKYWATCH_LOCATION_NAME=Ambleside
# IANA timezone (defaults to the geocoder's answer, else Europe/London). Also
# used as the container clock for the 06:30 / 16:30 schedule.
TZ=Europe/London

# Your local LLM (OpenAI-compatible: Ollama, LM Studio, a proxy...).
# From Docker on the same machine use host.docker.internal instead of localhost.
SKYWATCH_LLM_BASE_URL=http://host.docker.internal:11434/v1
SKYWATCH_LLM_MODEL=qwen3:32b
SKYWATCH_LLM_FAST_MODEL=qwen3:8b
# SKYWATCH_LLM_API_KEY=

# Phone pushes via ntfy (https://ntfy.sh). Pick a long random topic name —
# topics are only as private as their name. Setting a topic enables pushes.
# SKYWATCH_NTFY_TOPIC=skywatch-a8f3k2p9q1
# SKYWATCH_NTFY_SERVER=https://ntfy.sh
# SKYWATCH_NTFY_ENABLED=true

# Native `skywatch serve` bind: "tailscale" (auto-detect), an IP, or 0.0.0.0.
# SKYWATCH_SERVE_HOST=tailscale
# SKYWATCH_SERVE_PORT=8092

# Docker only: which HOST address compose publishes the dashboard on.
# Linux host: your Tailscale IP keeps it tailnet-only. Docker Desktop
# (Mac/Windows) can't bind to the Tailscale interface — leave loopback and
# run `tailscale serve --bg 8092` for tailnet access. 0.0.0.0 = whole LAN.
# SERVE_BIND_IP=127.0.0.1
# SERVE_PORT=8092

# Native: where cache/, output/ and state.db live (default: next to config.yaml).
# SKYWATCH_DATA_DIR=.
# Docker: mount a HOST directory at /data instead of the named volume, so the
# native CLI (`uv run skywatch status`) and the containers share one data set.
# SKYWATCH_DATA_HOST_DIR=/Users/you/skywatch-data
